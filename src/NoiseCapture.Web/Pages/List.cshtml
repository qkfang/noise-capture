@page
@model ListModel
@{
    ViewData["Title"] = "Entries";
}

<section>
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="h3 mb-1">Recent noise entries</h1>
            <p class="text-muted mb-0">Showing the last @Model.Entries.Count of @Model.TotalCount entries.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Add" class="btn btn-primary">Add new entry</a>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string status && !string.IsNullOrWhiteSpace(status))
    {
        <div class="alert alert-info" role="alert">@status</div>
    }

    @if (Model.Entries.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            No entries yet. Use <strong>Add new entry</strong> to record one.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle table-entries">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">When (Sydney)</th>
                        <th scope="col">Intensity</th>
                        <th scope="col">Loudness</th>
                        <th scope="col">Tone</th>
                        <th scope="col" title="Continued from last entry">Cont.</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Entries.Count; i++)
                    {
                        var entry = Model.Entries[i];
                        var rowClass = i % 2 == 0 ? "entry-row-a" : "entry-row-b";
                        var noteClass = i % 2 == 0 ? "entry-note-a" : "entry-note-b";
                        <tr class="@rowClass">
                            <td>@entry.Id</td>
                            <td>@SydneyTime.Convert(entry.RecordedAtSydney).ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@entry.Intensity</td>
                            <td>@entry.Loudness</td>
                            <td>@entry.Tone</td>
                            <td>@(entry.ContinuedFromLast ? "Yes" : "No")</td>
                            <td class="text-end">
                                <a asp-page="/Edit" asp-route-recordedAt="@entry.RecordedAtSydney.ToString("o")"
                                   class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                <form method="post" asp-page-handler="Delete" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this entry?');">
                                    <input type="hidden" name="recordedAt"
                                           value="@entry.RecordedAtSydney.ToString("o")" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                        <tr class="@noteClass">
                            <td colspan="7" class="small">
                                <strong>Sources:</strong>
                                @(entry.NoiseSources.Count == 0 ? "—" : string.Join(", ", entry.NoiseSources))
                                &nbsp;&nbsp;
                                <strong>Location:</strong>
                                @(entry.Locations.Count == 0 ? "—" : string.Join(", ", entry.Locations))
                            </td>
                        </tr>
                        <tr class="@noteClass">
                            <td colspan="7" class="small text-muted">
                                <strong>How it impacts you:</strong>
                                @(string.IsNullOrWhiteSpace(entry.Note) ? "—" : entry.Note)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
