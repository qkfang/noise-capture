@page
@model ListModel
@{
    ViewData["Title"] = "All entries";
}

<section>
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="h3 mb-1">All noise entries</h1>
            <p class="text-muted mb-0">Total: @Model.Entries.Count</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Add" class="btn btn-primary">Add new entry</a>
            <a asp-page="/Index" class="btn btn-outline-secondary">Recent (20)</a>
        </div>
    </div>

    @if (Model.Entries.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            No entries yet. Use <strong>Add new entry</strong> to record one.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">When (Sydney)</th>
                        <th scope="col">Sources</th>
                        <th scope="col">Intensity</th>
                        <th scope="col">Feeling</th>
                        <th scope="col">Location</th>
                        <th scope="col">Note</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td>@entry.RecordedAtSydney.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@string.Join(", ", entry.NoiseSources)</td>
                            <td>@entry.Intensity</td>
                            <td>@entry.Feeling</td>
                            <td>@string.Join(", ", entry.Locations)</td>
                            <td>@entry.Note</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
