@page
@model IndexModel
@{
    ViewData["Title"] = "Recent entries";
}

<section>
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="h3 mb-1">Recent noise entries</h1>
            <p class="text-muted mb-0">Showing the latest @Model.Entries.Count of up to 20 entries.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Add" class="btn btn-primary">Add new entry</a>
            <a asp-page="/List" class="btn btn-outline-secondary">View all</a>
        </div>
    </div>

    @if (Model.Entries.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            No entries yet. Use <strong>Add new entry</strong> to record one.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">When (Sydney)</th>
                        <th scope="col">Sources</th>
                        <th scope="col">Intensity</th>
                        <th scope="col">Loudness</th>
                        <th scope="col">Tone</th>
                        <th scope="col">Location</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td>@entry.RecordedAtSydney.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@string.Join(", ", entry.NoiseSources)</td>
                            <td>@entry.Intensity</td>
                            <td>@entry.Loudness</td>
                            <td>@entry.Tone</td>
                            <td>@string.Join(", ", entry.Locations)</td>
                        </tr>
                        <tr class="table-light">
                            <td colspan="6" class="small text-muted">
                                <strong>How it impacts you:</strong>
                                @(string.IsNullOrWhiteSpace(entry.Note) ? "—" : entry.Note)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
